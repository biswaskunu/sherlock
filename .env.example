# sherlock environment template
# Copy to .env and fill in before running

# Agent settings
AGENT_POLL_INTERVAL_SECS=3
AGENT_FLUSH_EVERY_N_SAMPLES=20

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Optional: full agent POST URL (overrides BACKEND_HOST/BACKEND_PORT composition)
# BACKEND_URL=http://127.0.0.1:8080/api/metrics/batch

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sherlock
